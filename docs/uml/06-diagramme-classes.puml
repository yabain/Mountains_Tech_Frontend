@startuml classe_global
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #F5F8FC
  BorderColor #00447E
  ArrowColor #333333
}
skinparam packageStyle folder
title Diagramme de classes — Frontend Angular Mountains Tech

package "core/models" {
  class ApiResponse<T> {
    +success : boolean
    +data : T
    +message? : string
    +code? : string
    +errors? : FieldError[]
  }
  class PaginatedResponse<T> {
    +items : T[]
    +pagination : Pagination
  }
  class Pagination {
    +page : number
    +limit : number
    +total : number
    +pages : number
  }
  class AuthUser {
    +id : string
    +email : string
    +name : string
    +role : UserRole
    +avatar? : string
    +location? : string
  }
  enum UserRole {
    SUPER_ADMIN
    ADMIN
    EDITOR
    COMMUNICATION
  }
  class Member {
    +id : string
    +companyName : string
    +slug : string
    +description : string
    +logoUrl? : string
    +website? : string
    +sectors : string[]
    +status : MemberStatus
  }
  enum MemberStatus {
    PENDING
    APPROVED
    REJECTED
    SUSPENDED
  }
  class EditorialContent {
    +id : string
    +title : string
    +slug : string
    +excerpt? : string
    +contentHtml : string
    +coverUrl? : string
    +status : ContentStatus
  }
  enum ContentStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
  }
  class TeamMember {
    +firstName : string
    +lastName : string
    +email : string
    +phone? : string
    +role? : string
  }
  class HackathonTeam {
    +id : string
    +teamName : string
    +schoolOrOrganization? : string
    +leader : TeamMember
    +members : TeamMember[]
    +projectIdea? : string
    +technologyStack : string[]
    +status : MemberStatus
  }
  class Announcement {
    +id : string
    +subject : string
    +contentHtml : string
    +audience : Audience
    +sendMode : "IMMEDIATE" | "SCHEDULED"
    +scheduledAt? : string
    +status : AnnouncementStatus
    +recipientCount : number
    +sentCount : number
  }
  enum AnnouncementStatus {
    DRAFT
    SCHEDULED
    SENDING
    SENT
    FAILED
    CANCELLED
  }
  HackathonTeam *-- TeamMember : leader + membres >
}

package "core/http" {
  class ApiService {
    +get<T>(route, params?) : Observable<T>
    +post<T>(route, body?) : Observable<T>
    +put<T>(route, body?) : Observable<T>
    +patch<T>(route, body?) : Observable<T>
    +delete<T>(route) : Observable<T>
    -baseUrl : string
  }
  class ApiRoutes {
    <<constant>>
    +public : PublicRoutes
    +admin : AdminRoutes
    +auth : AuthRoutes
  }
}

package "core/auth" {
  class AuthService {
    +currentUser$ : BehaviorSubject<AuthUser | null>
    +login(email, password) : Observable<AuthUser>
    +logout() : void
    +storeToken(token) : void
    +getToken() : string | null
    +hasDashboardAccess() : boolean
    +permissionsForUser() : string[]
  }
  class AuthGuard
  class AdminGuard
  class AdminPermissionGuard {
    -matchPermission(route, user) : boolean
  }
  class AuthInterceptor
  class ErrorInterceptor {
    -handle401() / -handle403() / -handle404()
    -handle422() / -handle429() / -handle500()
  }
  class LoadingInterceptor
}

package "core/services" {
  class NotificationService {
    +success(msg) : void
    +error(msg) : void
    +info(msg) : void
    +warning(msg) : void
    +messages : Signal<AppAlert[]>
  }
  class LoadingService {
    +isLoading$ : BehaviorSubject<boolean>
    +show() / +hide()
  }
  class SiteDataService {
    +getSection(name) : Observable<any>
    -source : /assets/data/site.json
  }
  class DashboardDataService {
    +load() : Observable<DashboardData>
  }
}

package "shared" {
  class PaginationComponent {
    +page : Input<number>
    +pages : Input<number>
    +change : Output<number>
  }
  class SafeHtmlPipe {
    +transform(html) : SafeHtml
  }
  class StateMessageComponent
}

package "features (public)" {
  class PublicLayoutComponent
  class HomeComponent
  class MemberListComponent
  class MemberApplicationComponent
  class ContactComponent
  class TeamRegistrationComponent
  class NewsletterSubscriptionComponent
  class LegalPagesComponent
}

package "features/admin" {
  abstract class AdminResourceBase {
    <<abstract>>
    #loading : signal<boolean>
    #saving : signal<boolean>
    #search : signal<string>
    #page : signal<number>
    #rows : signal<any[]>
    +load() : void
    +onSearchChange(term) : void
    +onPageChange(page) : void
    +openCreate() / +openEdit(row)
    +confirmDelete(row)
    +saveEntity()
    +statusClass(status) : string
  }
  class AdminResourceConfig {
    +endpoint : string
    +columns : Column[]
    +fields : Field[]
    +creatable / +editable / +deletable : boolean
    +statusField? : string
  }
  class AdminMembersComponent
  class AdminEventsComponent
  class AdminProjectsComponent
  class AdminAnnouncementsComponent
  class AnnouncementEditorComponent {
    +contentHtml : string
    +previewAudience() : void
    +sendNow() / +schedule()
    -estimateRecipients() : void
  }
  class AdminLayoutComponent {
    +navGroups : NavGroup[]
    +currentUser$
    +logout()
  }
  AdminMembersComponent --|> AdminResourceBase
  AdminEventsComponent --|> AdminResourceBase
  AdminProjectsComponent --|> AdminResourceBase
  AdminAnnouncementsComponent --|> AdminResourceBase
}

' ---------- Relations ----------
ApiService ..> ApiRoutes : utilise >
AuthService --> ApiService : >
NotificationService ..> ApiResponse : notifie >
AdminResourceBase --> ApiService : >
AdminResourceBase --> AdminResourceConfig : >
AdminResourceBase --> NotificationService : >
AnnouncementEditorComponent --> ApiService : >
DashboardDataService --> ApiService : >
SiteDataService ..> HomeComponent : alimente (statique)
HomeComponent --> ApiService : «à brancher» GET /public/home >
MemberApplicationComponent --> ApiService : >
ContactComponent --> ApiService : >
TeamRegistrationComponent --> ApiService : >
AuthInterceptor --> AuthService : lit le token >
ErrorInterceptor --> NotificationService : toasts >
AdminPermissionGuard --> AuthService : permissions >
AdminLayoutComponent --> AuthService : profil + rôle >
PaginationComponent ..> PaginatedResponse : affiche >
MemberStatus <.. Member : statut >
ContentStatus <.. EditorialContent : statut >
AnnouncementStatus <.. Announcement : statut >
UserRole <.. AuthUser : rôle >
MemberStatus <.. HackathonTeam : statut >

@enduml
