@startuml deploy_mountains
skinparam node {
  BackgroundColor #F5F8FC
  BorderColor #00447E
}
skinparam artifact {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam database {
  BackgroundColor #EAF7EF
  BorderColor #1F7A3D
}
title Diagramme de déploiement — Mountains Tech (Angular + NestJS + MongoDB Atlas)

node "Poste client (utilisateur)" as client {
  artifact "Navigateur web\nChrome / Firefox / Edge / Safari" as nav
  artifact "SPA Angular19\nindex.html + JS chunks (lazy loading)\n+ SCSS compilé + assets (icons.svg, site.json)" as spa
  artifact "localStorage\n- access_token (JWT)\n- auth_user" as store
  nav -[hidden]- store
}

node "Serveur web / Hébergement (ex. Nginx)" as web {
  artifact "Fichiers de distribution dist/\nHTML · CSS · JS · robots.txt · sitemap.xml" as dist
  artifact "CDN / images\nheroBg.webp, logos, covers (WebP/AVIF)" as cdn
}

node "Serveur d'application — Node.js 22" as app {
  artifact "API REST NestJS /api/v1\n· Auth (JWT, bcrypt)\n· Guards + rôles serveur\n· Modules publics & admin\n· Rate limiting / validation (422, 429)\n· Worker d'envoi des annonces" as api
}

cloud "MongoDB Atlas (cloud)" {
  database "Base de données MongoDB\nmembres · projets · activités · événements\nhackathons · équipes · annonces · contacts\nusers · newsletter · audit-logs · settings" as db
}

node "Services externes" {
  artifact "Fournisseur SMTP\n(expédition des annonces)" as smtp
  artifact "Service d'authentification externe\n(optionnel : réinitialisation mot de passe)" as mail
}

' ---------- Flux ----------
nav -[#00447E,bold]-> dist : HTTPS — chargement initial de la SPA
nav -> cdn : HTTPS — images / médias
nav -[#00447E,bold]-> api : HTTPS / JSON (fetch, Angular HttpClient)\nAuthorization: Bearer <JWT>\nX-Correlation-Id
nav <-> store : lecture / écriture du token

api -[#1F7A3D]-> db : TCP 27017 — Mongoose ODM\n(chiffrement TLS activé)
api -> smtp : SMTP / API externe (envoi massif déclé côté serveur)
api -> mail : HTTPS (emails transactionnels)

note bottom of api
  **Environnements** (fichiers environment) :
  · development → http://localhost:3000/api/v1
  · staging     → https://staging-api.mountainstech.cm/api/v1
  · production  → https://api.mountainstech.cm/api/v1
  Aucune clé secrète n'est stockée côté frontend.
end note

note bottom of nav
  **SPA statique** : aucun SSR actif (Angular Universal
  non configuré — « recommandé » dans le cahier des charges).
  Le SEO repose sur meta/OG injectés par le SeoService
  et sur robots.txt / sitemap.xml livrés avec la SPA.
end note

@enduml
