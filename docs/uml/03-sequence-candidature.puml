@startuml seq_candidature
title Séquence — Soumission d'une candidature d'adhésion (UC09)

actor "Entreprise" as ENT
participant "MemberApplicationComponent\n(wizard 6 étapes)" as MAC
participant "ApiService" as SVC
participant "API NestJS\n/api/v1" as API
participant "MongoDB Atlas" as DB

ENT -> MAC : accède à /devenir-membre
activate MAC
MAC -> API : GET listes de référence (secteurs…)
API --> MAC : données de formulaire

loop Étapes 1 → 4 (identité, entreprise, représentant, consentement)
  ENT -> MAC : saisit les champs
  MAC -> MAC : validation de l'étape\n(messages d'erreur / toast)
end

ENT -> MAC : étape 5 — récapitulatif des données
MAC -> MAC : vérification finale (validateStep2,\nsecteurs obligatoires)
ENT -> MAC : clique « Confirmer l'envoi »
MAC -> MAC : submitting = true\n(bouton désactivé — anti double-submit)
MAC -> SVC : POST /public/members/applications
activate SVC
SVC -> API : POST /api/v1/public/members/applications
activate API
API -> DB : insert members_applications { status: PENDING }
DB --> API : applicationId
API --> SVC : 201 { success: true, data: { applicationId, status } ,\nmessage: "Demande soumise pour validation" }
deactivate API
SVC --> MAC : réponse
deactivate SVC
MAC -> ENT : étape 6 — écran de confirmation « demande reçue »
deactivate MAC

alt 400 VALIDATION_ERROR
  API --> MAC : { message, code, errors: [{ field, message }] }
  MAC -> ENT : messages d'erreur par champ
else 409 CONFLICT (déjà candidat)
  API --> MAC : { code: CONFLICT }
  MAC -> ENT : message « Une demande existe déjà »
else 429 TOO_MANY_REQUESTS
  API --> MAC : { code: TOO_MANY_REQUESTS }
  MAC -> ENT : message « Trop de tentatives, réessayez plus tard »
else erreur réseau / 500
  API --> MAC : INTERNAL_SERVER_ERROR
  MAC -> MAC : submitting = false (réarmement)
  MAC -> ENT : message d'erreur + possibilité de réessayer
end

note right of API
  Ensuite : l'administrateur valide via UC06
  (PATCH /admin/members/:id/status) et la demande
  apparaît sur le site public (UC02).
end note

@enduml
