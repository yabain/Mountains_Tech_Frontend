@startuml seq_auth
title Séquence — Authentification d'un administrateur (UC14)

actor "Administrateur" as ADM
participant "Navigateur\n(Angular SPA)" as NAV
participant "LoginComponent" as LC
participant "AuthService" as AS
participant "API NestJS\n/api/v1" as API
participant "MongoDB Atlas" as DB

ADM -> LC : saisit email + mot de passe
activate LC
LC -> LC : validation Reactive Forms\n(required, email, minLength 8)\n+ désactivation du bouton (anti double-submit)
LC -> AS : login(email, password)
activate AS
AS -> API : POST /api/v1/auth/login
activate API
API -> DB : recherche utilisateur + comparaison hash
DB --> API : user + passwordHash
API --> AS : 200 { accessToken, refreshToken, user }
deactivate API
AS -> AS : storeToken() → localStorage['access_token']\n+ persistance de auth_user
AS --> LC : AuthUser connecté (id, name, role)
deactivate AS
LC -> NAV : redirection → /dashboard\n(AdminGuard vérifie le rôle)
deactivate LC

alt identifiants invalides
  API --> LC : 401 UNAUTHORIZED { code }
  LC -> LC : message d'erreur + réarmement du bouton
else compte sans droits dashboard
  API --> LC : 200 mais rôle hors SUPER_ADMIN/ADMIN/EDITOR/COMMUNICATION
  LC -> NAV : redirection → / (site public)
else requête protégée avec token expiré
  API --> NAV : 401 UNAUTHORIZED
  NAV -> AS : logout() + purge du stockage
  NAV -> LC : redirection → /login
end

@enduml
